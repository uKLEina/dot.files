#!/bin/bash
# 1Password の秘密情報を、GNOME Keyring に写す。
#
# 使い方: secret-sync [リスト]   （省略すると ~/.config/secret-sync/secrets.tsv）
#
# 大元は 1Password で、keyring は写し。keyring で直接足したり書き換えたりせず、
# リストに足してから同期する。リストから消した物は、keyring からは消えない
# （secret-tool clear <属性> <値> ... で消す）。
#
# 1Password を1件読むのに約4秒かかる。値は画面に出さない。
set -uo pipefail

LIST=${1:-$HOME/.config/secret-sync/secrets.tsv}
OP=${OP:-/mnt/c/Users/kobayashi.naohiro/AppData/Local/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_Microsoft.Winget.Source_8wekyb3d8bbwe/op.exe}

failed=0
while IFS=$'\t' read -r ref label attrs; do
  [[ -z $ref || $ref == \#* ]] && continue
  args=()
  for kv in $attrs; do args+=("${kv%%=*}" "${kv#*=}"); done
  # op.exe が while の標準入力（リスト）を読まないよう、/dev/null をつなぐ
  if ! val=$("$OP" read "$ref" </dev/null); then
    echo "読めない: $label" >&2
    failed=1
    continue
  fi
  if printf '%s' "$val" | secret-tool store --label="$label" "${args[@]}"; then
    echo "写した: $label"
  else
    echo "書けない: $label" >&2
    failed=1
  fi
  unset val
done <"$LIST"
exit $failed
